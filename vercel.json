    {
      "source": "/app/screenLayouts",
      "destination": "/players/layouts/",
      "permanent": false
    },
    {
      "source": "/app/tags/bulk",
      "destination": "/players/tags/#bulk-tags-for-players",
      "permanent": false
    },
    {
      "source": "/app/tags/:path*",
      "destination": "/players/tags/",
      "permanent": false
    },
    {
      "source": "/app/appVersion/:path*",
      "destination": "/players/app-versions/",
      "permanent": false
    },
    {
      "source": "/app/playStatistics/:path*",
      "destination": "/players/display-statistics/",
      "permanent": false
    },
    {
      "source": "/app/licenses/:path*",
      "destination": "/players/licenses/",
      "permanent": false
    },
    {
      "source": "/app/contentCreation/:path*",
      "destination": "/content/content-creation/",
      "permanent": false
    },
    {
      "source": "/app/extraContent/:path*",
      "destination": "/content/data-feeds/",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/edit/:path*",
      "destination": "/playlists/playlist-groups/#add-a-new-playlist-group",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/:id/fallbackPlaylist",
      "destination": "/playlists/playlist-groups/#fallback-playlist",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/:id/fallbackLayout",
      "destination": "/playlists/playlist-groups/#fallback-layout",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/:id/bulkAssign",
      "destination": "/playlists/playlist-groups/#bulk-assign-players",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/:id/addNotScheduledPlaylist",
      "destination": "/playlists/playlist-groups/#event-playlists",
      "permanent": false
    },
    {
      "source": "/app/playerGroups/:id",
      "destination": "/playlists/playlist-groups/#playlist-group-details",
      "permanent": false
    },
    {
      "source": "/app/playerGroups",
      "destination": "/playlists/playlist-groups/",
      "permanent": false
    },
    {
      "source": "/app/playlists/edit/:path*",
      "destination": "/playlists/playlists/#add-a-new-playlist",
      "permanent": false
    },
    {
      "source": "/app/playlists/:path*",
      "destination": "/playlists/playlists/",
      "permanent": false
    },
    {
      "source": "/app/files/:path*",
      "destination": "/playlists/media-manager/",
      "permanent": false
    },
    {
      "source": "/app/synchronizations/:path*",
      "destination": "/playlists/synchronizations/",
      "permanent": false
    },
    {
      "source": "/app/devices/:path*",
      "destination": "/control/devices/",
      "permanent": false
    },
    {
      "source": "/app/hardwareDrivers/:path*",
      "destination": "/control/hardware-drivers/",
      "permanent": false
    },
    {
      "source": "/app/support",
      "destination": "/about/support/",
      "permanent": false
    },
    {
      "source": "/app/about",
      "destination": "/about/about/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
